{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chess-against-engine",
  "version": "0.1.1",
  "identifier": "com.loloof64.chess-against-engine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chess-against-engine",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "android": {
      "autoIncrementVersionCode": false,
      "minSdkVersion": 24,
      "versionCode": 4
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQjE2NzkyRjlDOUQyNDcKUldSSDBzbjVrbWV4V3B4dmpabDNYQjBpVDlwQlp3Z1lUV2dxK2x3anU1cVkxcTJJeWRuanMvYzAK",
      "endpoints": [
        "https://github.com/loloof64/chess-against-engine/releases/latest/download/latest.json"
      ]
    }
  }
}
